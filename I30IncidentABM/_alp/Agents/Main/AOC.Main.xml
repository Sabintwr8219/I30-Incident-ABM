	<StartupCode><![CDATA[String[] headers = {
    "run_id",
    "veh_id",
    "route",
    "departure_time_min",
    "arrival_time_min",
    "diversion_time_min",
    "rejoin_time_min",
    "distance_travelled_m",
    "diversion_rejoin_distance_m"
};

for (int c = 0; c < headers.length; c++) {
    excelResults.setCellValue(headers[c], "Vehicles", 1, c + 1);
}


int lastRow = excelResults.getLastRowNum("Vehicles");
excelRow = Math.max(2, lastRow + 1);

// Assign the next run ID.
if (lastRow >= 2) {
    runId = (int) excelResults.getCellNumericValue(
        "Vehicles", lastRow, 1
    ) + 1;
} else {
    runId = 1;
}

nextVehicleId = 1;]]></StartupCode>
