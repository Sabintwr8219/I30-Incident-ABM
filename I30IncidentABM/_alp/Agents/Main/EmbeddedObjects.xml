					<Code><![CDATA[agent.exitTime = time();
agent.actualTravelTime = agent.exitTime - agent.entryTime;
agent.delay = agent.actualTravelTime - agent.normalTravelTime;
agent.tripCompleted = true;
completedTrips++;
if (agent.currentRoute == 1) {
    vehiclesOnRouteA--;
    tripTimeA.add(agent.actualTravelTime);
} else {
    vehiclesOnRouteB--;
    tripTimeB.add(agent.actualTravelTime);
}
tripTimeAll.add(agent.actualTravelTime);

// Baseline metrics
delayAll.add(agent.delay);
totalSystemTravelTime += agent.actualTravelTime;
trafficIncident.trackTripForRecovery(agent.actualTravelTime);

// Time series for the plots
winDelaySum += agent.delay;
winTTSum += agent.actualTravelTime;
winDoneN++;
sampleTimeSeries();

exportVehicle(agent);]]></Code>
